{
  "name": "amsirartrip-nextjs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "browserslist": [
    "chrome >= 92",
    "edge >= 92",
    "firefox >= 90",
    "safari >= 15.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node test.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/app/**/*.css\"",
    "lint:css:fix": "stylelint \"src/app/**/*.css\" --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:local": "node scripts/verify-security.mjs",
    "verify:prod": "node scripts/verify-security.mjs https://amsirartrip.com",
    "react-doctor": "pnpm dlx react-doctor@latest . --no-ami",
    "react-doctor:verbose": "pnpm dlx react-doctor@latest . --verbose --no-ami"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "isomorphic-dompurify": "3.0.0",
    "lucide-react": "0.575.0",
    "motion": "^12.34.3",
    "next": "^16.1.6",
    "next-intl": "^4.8.3",
    "nodemailer": "^8.0.1",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-google-recaptcha": "3.1.0",
    "tailwind-merge": "3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/plugin-transform-private-methods": "^7.28.6",
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^25.3.2",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-google-recaptcha": "2.1.9",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "0.34.5",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "stylelint-order": "^7.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
